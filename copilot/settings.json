{
  "renderMarkdown": true,
  "theme": "github",
  "defaultPermissionMode": "allow-all",
  "autoUpdatesChannel": "stable",
  "effortLevel": "high",
  "disabledMcpServers": [
    "github-mcp-server"
  ],
  "banner": "never",
  "tabs": {
    "enabled": false
  },
  "sidebar": {
    "enabled": false
  },
  "scrollbar": false,
  "footer": {
    "showModelEffort": true,
    "showDirectory": false,
    "showBranch": false,
    "showContextWindow": false,
    "showQuota": false,
    "showAiUsed": false,
    "showAgent": false,
    "showCodeChanges": false,
    "showUsername": false,
    "showSandbox": false,
    "showYolo": false,
    "showCiStatus": false,
    "showSchedules": false,
    "showPullRequest": false
  },
  "enabledPlugins": {
    "html-plan@claude-community": true,
    "mpc@mpc": true,
    "html-explain@html-explain": true
  }
}
