{
  "cleanupPeriodDays": 36500,
  "permissions": {
    "allow": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(*gog* send *)",
      "Bash(*gog* send)",
      "Bash(*gog* config *)",
      "Bash(*gog* --home*)",
      "Bash(*GOG_HOME*)",
      "Bash(*gogcli/config*)",
      "Edit(~/Library/Application Support/gogcli/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "env": {
    "ENABLE_STOP_REVIEW": "0"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/init-submodules.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/html_plan_verify.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/html_plan_verify.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "html-plan@claude-community": true,
    "security-guidance@claude-plugins-official": true,
    "duckdb-skills@claude-plugins-official": true,
    "microsoft-docs@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
