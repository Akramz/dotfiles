# Brewfile.general — everything the Mac setup needs.
#
#   brew bundle install --file=Brewfile.general
#   brew bundle check   --file=Brewfile.general   # is this machine satisfied?
#
# Work-only software (Microsoft casks/CLIs) lives in work/Brewfile, installed
# with --with-work. Your own apps go in personal/Brewfile.

# ── shell + terminal ────────────────────────────────────────────
brew "zsh"
brew "tmux"
brew "fzf"                # tp's predecessor; still used ad hoc
brew "autojump"           # provides `j`; .zshrc aliases z=j
brew "ripgrep"
brew "htop"

# ── git ─────────────────────────────────────────────────────────
brew "git"
brew "gh"                 # also the git credential helper (see home/.gitconfig)
brew "difftastic"         # git dft
brew "hunk"               # review-first terminal diff viewer; skill: claude/skills/hunk

# ── languages / runtimes ────────────────────────────────────────
brew "node"
brew "uv"                 # Python tools and envs
brew "ty"                 # Python type checker for the claude/skills/ty-lsp plugin
brew "duckdb"             # SQL over parquet/csv/geo files; used by agents
brew "go"
brew "rbenv"
brew "cmake"
brew "llvm"
brew "esbuild"

# ── documents & media ───────────────────────────────────────────
brew "pandoc"
brew "graphviz"
brew "imagemagick"
brew "poppler"
brew "ffmpeg"
brew "yt-dlp"

# ── geospatial ──────────────────────────────────────────────────
brew "osmium-tool"
brew "pmtiles"

# ── cloud ───────────────────────────────────────────────────────
brew "awscli"
brew "gogcli"             # Google (Gmail, Calendar, Drive) for agents; see the gog skill

# ── local inference ─────────────────────────────────────────────
brew "llama.cpp"
brew "nvtop"

# ── misc utilities ──────────────────────────────────────────────
brew "wget"
brew "rsync"              # VMs rsync with the Mac through mac-sshd; macOS openrsync breaks with GNU rsync
brew "aria2"
brew "nmap"
brew "unar"
brew "age"                # file encryption
brew "caddy"
brew "jq"

# ════════════════════════════════════════════════════════════════
# Casks
# ════════════════════════════════════════════════════════════════

# ── browsers ────────────────────────────────────────────────────
cask "google-chrome"      # primary

# ── terminal + editor ───────────────────────────────────────────
cask "ghostty"
cask "visual-studio-code"

# ── AI ──────────────────────────────────────────────────────────
cask "claude"
brew "pi-coding-agent"    # the `pi` CLI used by tp / pie

# ── knowledge ───────────────────────────────────────────────────
cask "obsidian"
cask "zotero"

# ── comms ───────────────────────────────────────────────────────
cask "slack"
cask "zoom"

# ── launcher + input ────────────────────────────────────────────
cask "raycast"            # bind to cmd+space, see MANUAL.md
cask "wispr-flow"         # dictation

# ── geo ─────────────────────────────────────────────────────────
cask "qgis"

# ── screen capture ──────────────────────────────────────────────
cask "kap"
cask "keycastr"

# ── dev infrastructure ──────────────────────────────────────────
cask "mactex-no-gui"      # pdflatex
cask "gcloud-cli"

# ── office ──────────────────────────────────────────────────────
cask "libreoffice"
